@{
    ViewData["Title"] = "報表主頁（Vue）";
}

<h2 class="mb-3">報表主頁</h2>

<!-- ✅ Vue 掛載點 + 樣式 -->
<div id="rm-reports-app"></div>
<link rel="stylesheet" href="~/reportmail/reportmail.css" />

<form id="__af__" method="post" class="d-none">
    @Html.AntiForgeryToken()
</form>


@* 🔒 舊版 DOM 全數移除（改用 Vue 版 UI）
<div class="row g-3 mb-3"> ... 三個下拉與按鈕 ... </div>
<div class="row g-4"> ... 三個 <canvas> chartLine/chartBar/chartPie ... </div>
<div id="exportModal"> ... 舊匯出 Modal ... </div>
<form id="defDeleteForm"> @Html.AntiForgeryToken() </form>
*@

@section Scripts {
    @* ❌ 舊版腳本（請保持移除/註解）
       <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
       <script src="~/js/report-index.js" asp-append-version="true"></script>
    *@

    <!-- ✅ 給前端用的 API 設定（沿用你現有路由；使用 api 單數欄位） -->
    <script>
        window.ReportPageConfig = {
            base: '/ReportMail',
            api: {
                line:      '@Url.Action("Line", "Reports", new { area = "ReportMail" })',
                bar:       '@Url.Action("Bar", "Reports", new { area = "ReportMail" })',
                pie:       '@Url.Action("Pie", "Reports", new { area = "ReportMail" })',
                defPayload:'@Url.Action("DefinitionPayload", "ReportDefinitions", new { area = "ReportMail" })',
                preview:   '@Url.Action("PreviewDraft", "ReportPreview", new { area = "ReportMail" })',
                sendExcel: '@Url.Action("SendExcel", "ReportExport", new { area = "ReportMail" })',
                sendPdf:   '@Url.Action("SendPdf", "ReportExport", new { area = "ReportMail" })',
                list: '@Url.Action("List", "ReportDefinitions", new { area = "ReportMail" })'
            }
        };
    </script>

    <!-- ✅ 載入 Vue 打包後的 JS（請先在 /frontend-reportmail 跑 npm run build） -->
    <script type="module" src="~/reportmail/reportmail.js"></script>

}
